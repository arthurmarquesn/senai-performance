generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ClassRoom {
  id    String @id @default(cuid())
  name  String @unique
  grade Int

  students         Student[]
  examApplications ExamApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id     String @id @default(cuid())
  name   String
  number Int?

  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id])

  results          ExamResult[]
  essayCorrections EssayCorrection[]
  bookProgresses   BookProgress[]
  answerSheets     AnswerSheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id             String     @id @default(cuid())
  title          String
  totalQuestions Int
  status         ExamStatus @default(DRAFT)

  grade Int @default(2)

  blocks           ExamBlock[]
  answerKey        AnswerKey[]
  results          ExamResult[]
  essayCorrections EssayCorrection[]
  applications     ExamApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExamBlock {
  id String @id @default(cuid())

  subject       Subject
  startQuestion Int
  endQuestion   Int

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  createdAt DateTime @default(now())
}

model AnswerKey {
  id String @id @default(cuid())

  question Int
  answer   Alternative
  canceled Boolean     @default(false)

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  createdAt DateTime @default(now())

  @@unique([examId, question])
}

model ExamResult {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  answers StudentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examId])
}

model StudentAnswer {
  id String @id @default(cuid())

  question Int
  answer   Alternative?

  examResultId String
  examResult   ExamResult @relation(fields: [examResultId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examResultId, question])
}

// ======================================================
// APLICAÇÃO DO SIMULADO EM UMA TURMA
// ======================================================

model ExamApplication {
  id String @id @default(cuid())

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id])

  answerSheets AnswerSheet[]
  scanBatches  AnswerSheetScanBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, classRoomId])
  @@index([examId])
  @@index([classRoomId])
}

// ======================================================
// FOLHA FÍSICA INDIVIDUAL
// ======================================================

model AnswerSheet {
  id String @id @default(cuid())

  code String @unique @db.VarChar(32)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  examApplicationId String
  examApplication   ExamApplication @relation(fields: [examApplicationId], references: [id])

  status AnswerSheetStatus @default(GENERATED)

  scans AnswerSheetScan[]

  generatedAt DateTime  @default(now())
  scannedAt   DateTime?
  correctedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examApplicationId])
  @@index([studentId])
  @@index([examApplicationId])
}

// ======================================================
// LOTE DE DIGITALIZAÇÃO
// ======================================================
//
// Representa o arquivo multipágina enviado pelo professor.
//
// Exemplo:
// gabaritos-IDEV-3.pdf
// 64 páginas
//
// Um ExamApplication pode possuir vários lotes.
// Isso permite reprocessamento ou novos uploads no futuro.
// ======================================================

model AnswerSheetScanBatch {
  id String @id @default(cuid())

  examApplicationId String
  examApplication   ExamApplication @relation(fields: [examApplicationId], references: [id])

  sourceFileName String  @db.VarChar(255)
  sourceFileKey  String? @db.VarChar(500)

  totalPages          Int @default(0)
  processedPages      Int @default(0)
  identifiedPages     Int @default(0)
  reviewRequiredPages Int @default(0)
  confirmedPages      Int @default(0)

  status ScanBatchStatus @default(UPLOADED)

  scans AnswerSheetScan[]

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examApplicationId])
  @@index([status])
}

// ======================================================
// DIGITALIZAÇÃO DE UMA PÁGINA
// ======================================================
//
// Cada registro representa UMA página do arquivo multipágina.
//
// Exemplo:
// página 17 do PDF
// QR encontrado: PF-ABCD-EFGH
// AnswerSheet correspondente localizada.
//
// answerSheetId é opcional porque inicialmente a página
// ainda pode não ter sido identificada.
// ======================================================

model AnswerSheetScan {
  id String @id @default(cuid())

  scanBatchId String
  scanBatch   AnswerSheetScanBatch @relation(fields: [scanBatchId], references: [id])

  pageNumber Int

  answerSheetId String?
  answerSheet   AnswerSheet? @relation(fields: [answerSheetId], references: [id])

  detectedCode String? @db.VarChar(32)

  status AnswerSheetScanStatus @default(PENDING)

  // Confiança da identificação pelo QR.
  // Valor esperado futuramente entre 0 e 1.
  qrConfidence Float?

  // Confiança do alinhamento/correção de perspectiva.
  alignmentConfidence Float?

  // Confiança geral da leitura daquela página.
  overallConfidence Float?

  // Informações úteis para auditoria/debug do processamento.
  rotationDegrees Float?

  // Referências opcionais para imagens armazenadas fora do banco.
  // Não armazenaremos a imagem binária no MySQL.
  sourceImageKey     String? @db.VarChar(500)
  normalizedImageKey String? @db.VarChar(500)

  answers DetectedAnswer[]

  processedAt DateTime?
  reviewedAt  DateTime?
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scanBatchId, pageNumber])
  @@index([answerSheetId])
  @@index([detectedCode])
  @@index([status])
}

// ======================================================
// RESPOSTA DETECTADA PELA VISÃO COMPUTACIONAL
// ======================================================
//
// Representa o que o algoritmo detectou em UMA questão.
//
// Não representa ainda o resultado oficial.
//
// Exemplo:
//
// Questão 17
//
// A = 0.08
// B = 0.11
// C = 0.76
// D = 0.07
// E = 0.09
//
// detectedAnswer = C
// detectionStatus = DETECTED
// confidence = 0.98
//
// Depois de revisão manual, finalAnswer pode ser alterada.
// ======================================================

model DetectedAnswer {
  id String @id @default(cuid())

  answerSheetScanId String
  answerSheetScan   AnswerSheetScan @relation(fields: [answerSheetScanId], references: [id])

  question Int

  detectedAnswer Alternative?

  detectionStatus DetectedAnswerStatus

  // Confiança final da decisão do detector.
  confidence Float?

  // Percentual/intensidade de preenchimento detectado
  // em cada bolha.
  //
  // Futuramente trabalharemos normalmente entre 0 e 1.
  fillA Float?
  fillB Float?
  fillC Float?
  fillD Float?
  fillE Float?

  // Resultado final após eventual revisão humana.
  //
  // Pode permanecer null em uma questão confirmada como
  // não respondida.
  finalAnswer Alternative?

  // Permite distinguir:
  //
  // finalAnswer = null + reviewed = false
  //   → ainda não revisada
  //
  // finalAnswer = null + reviewed = true
  //   → revisão confirmou questão em branco
  reviewed Boolean @default(false)

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([answerSheetScanId, question])
  @@index([detectionStatus])
}

// ======================================================
// USUÁRIOS
// ======================================================

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(TEACHER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// REDAÇÃO
// ======================================================

model EssayCorrection {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id])

  competency1 Int @default(0)
  competency2 Int @default(0)
  competency3 Int @default(0)
  competency4 Int @default(0)
  competency5 Int @default(0)

  totalScore Int @default(0)

  comment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examId])
}

// ======================================================
// LEITURAS
// ======================================================

model Book {
  id String @id @default(cuid())

  title       String
  author      String
  description String?        @db.Text
  category    BookCategory
  type        BookType
  difficulty  BookDifficulty @default(MEDIUM)

  literarySchool String?
  originalYear   Int?
  publicDomain   Boolean @default(true)
  sourceUrl      String?

  vestibularRelevance String?
  enemRelevance       String? @db.Text
  themes              String? @db.Text
  readingTimeMinutes  Int?

  progresses BookProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, author])
}

model BookProgress {
  id String @id @default(cuid())

  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  status   ReadingStatus @default(WANT_TO_READ)
  progress Int           @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, studentId])
}

// ======================================================
// MODELOS LEGADOS
// ======================================================

model LegacyAluno {
  id      Int     @id @default(autoincrement())
  nome    String  @db.VarChar(100)
  tecnico String  @db.VarChar(100)
  serie   String? @db.Char(14)

  redacoes   LegacyRedacao[]
  resultados LegacyResultado[]

  @@map("alunos")
}

model LegacySimulado {
  id          Int    @id @default(autoincrement())
  jornada     String @db.VarChar(100)
  numeroProva Int    @map("numero_prova")
  serie       String @db.VarChar(45)

  redacoes   LegacyRedacao[]
  resultados LegacyResultado[]

  @@unique([jornada, numeroProva, serie], map: "unique_simulado")
  @@map("simulados")
}

model LegacyRedacao {
  id         Int  @id @default(autoincrement())
  alunoId    Int  @map("aluno_id")
  simuladoId Int? @map("simulado_id")

  competencia1 Int? @default(0)
  competencia2 Int? @default(0)
  competencia3 Int? @default(0)
  competencia4 Int? @default(0)
  competencia5 Int? @default(0)

  notaTotal  Int?      @default(0) @map("nota_total")
  comentario String?   @db.Text
  dataEnvio  DateTime? @default(now()) @map("data_envio")

  aluno    LegacyAluno     @relation(fields: [alunoId], references: [id])
  simulado LegacySimulado? @relation(fields: [simuladoId], references: [id])

  @@index([alunoId], map: "redacoes_aluno_id_idx")
  @@index([simuladoId], map: "redacoes_simulado_id_idx")
  @@map("redacoes")
}

model LegacyResultado {
  id         Int  @id @default(autoincrement())
  alunoId    Int? @map("aluno_id")
  simuladoId Int? @map("simulado_id")

  matematica     Int? @default(0)
  portugues      Int? @default(0)
  biologia       Int? @default(0)
  fisica         Int? @default(0)
  quimica        Int? @default(0)
  ingles         Int? @default(0)
  sociologia     Int? @default(0)
  filosofia      Int? @default(0)
  historia       Int? @default(0)
  geografia      Int? @default(0)
  educacaoFisica Int? @default(0) @map("educacao_fisica")
  artes          Int? @default(0)

  totalAcertos  Int? @default(0) @map("total_acertos")
  totalErros    Int? @default(0) @map("total_erros")
  totalQuestoes Int? @default(0) @map("total_questoes")

  aluno    LegacyAluno?    @relation(fields: [alunoId], references: [id])
  simulado LegacySimulado? @relation(fields: [simuladoId], references: [id])

  @@unique([alunoId, simuladoId], map: "unique_aluno_simulado")
  @@index([alunoId], map: "resultados_aluno_id_idx")
  @@index([simuladoId], map: "resultados_simulado_id_idx")
  @@map("resultados")
}

// ======================================================
// ENUMS
// ======================================================

enum ExamStatus {
  DRAFT
  IN_PROGRESS
  FINISHED
}

enum AnswerSheetStatus {
  GENERATED
  SCANNED
  REVIEW_REQUIRED
  CORRECTED
}

// ======================================================
// STATUS DO ARQUIVO MULTIPÁGINA
// ======================================================

enum ScanBatchStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  READY_FOR_CONFIRMATION
  CONFIRMED
  FAILED
}

// ======================================================
// STATUS DE UMA PÁGINA DIGITALIZADA
// ======================================================

enum AnswerSheetScanStatus {
  PENDING
  PROCESSING
  IDENTIFIED
  PROCESSED
  REVIEW_REQUIRED
  CONFIRMED
  DUPLICATE
  FAILED
}

// ======================================================
// RESULTADO DA DETECÇÃO DE UMA QUESTÃO
// ======================================================

enum DetectedAnswerStatus {
  DETECTED
  BLANK
  MULTIPLE
  UNCERTAIN
}

enum Alternative {
  A
  B
  C
  D
  E
}

enum Subject {
  MATEMATICA
  FISICA
  QUIMICA
  BIOLOGIA
  PORTUGUES
  INGLES
  ARTES
  EDUCACAO_FISICA
  SOCIOLOGIA
  FILOSOFIA
  GEOGRAFIA
  HISTORIA
}

enum UserRole {
  ADMIN
  TEACHER
}

enum BookCategory {
  LITERATURA_BRASILEIRA
  LITERATURA_PORTUGUESA
  CLASSICO_UNIVERSAL
  FILOSOFIA
  SOCIOLOGIA
  REPERTORIO_ENEM
}

enum BookType {
  ROMANCE
  CONTO
  POESIA
  TEATRO
  ENSAIO
  FILOSOFIA
  POLITICA
}

enum BookDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  FINISHED
  PAUSED
}
