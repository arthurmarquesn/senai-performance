generator client {
  provider = "prisma-client-js"
}

enum ClassroomConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
  REVOKED
}

enum ClassroomPublicationStatus {
  PENDING
  CREATED
  FAILED
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ClassRoom {
  id    String @id @default(cuid())
  name  String @unique
  grade Int

  students         Student[]
  examApplications ExamApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id     String @id @default(cuid())
  name   String
  number Int?

  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id])

  results          ExamResult[]
  essayCorrections EssayCorrection[]
  bookProgresses   BookProgress[]
  answerSheets     AnswerSheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id             String     @id @default(cuid())
  title          String
  totalQuestions Int
  status         ExamStatus @default(DRAFT)

  grade Int @default(2)

  blocks           ExamBlock[]
  answerKey        AnswerKey[]
  results          ExamResult[]
  essayCorrections EssayCorrection[]
  applications     ExamApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExamBlock {
  id String @id @default(cuid())

  subject       Subject
  startQuestion Int
  endQuestion   Int

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  createdAt DateTime @default(now())
}

model AnswerKey {
  id String @id @default(cuid())

  question Int
  answer   Alternative
  canceled Boolean     @default(false)

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  createdAt DateTime @default(now())

  @@unique([examId, question])
}

model ExamResult {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  answers StudentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examId])
}

model StudentAnswer {
  id String @id @default(cuid())

  question Int
  answer   Alternative?

  examResultId String
  examResult   ExamResult @relation(fields: [examResultId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examResultId, question])
}

// ======================================================
// APLICAÇÃO DO SIMULADO EM UMA TURMA
// ======================================================

model ExamApplication {
  id String @id @default(cuid())

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id])

  answerSheets AnswerSheet[]
  scanBatches  AnswerSheetScanBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, classRoomId])
  @@index([examId])
  @@index([classRoomId])
}

// ======================================================
// FOLHA FÍSICA INDIVIDUAL
// ======================================================

model AnswerSheet {
  id String @id @default(cuid())

  code String @unique @db.VarChar(32)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  examApplicationId String
  examApplication   ExamApplication @relation(fields: [examApplicationId], references: [id])

  status AnswerSheetStatus @default(GENERATED)

  scans AnswerSheetScan[]

  generatedAt DateTime  @default(now())
  scannedAt   DateTime?
  correctedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examApplicationId])
  @@index([studentId])
  @@index([examApplicationId])
}

// ======================================================
// LOTE DE DIGITALIZAÇÃO
// ======================================================
//
// Representa o arquivo multipágina enviado pelo professor.
//
// Exemplo:
// gabaritos-IDEV-3.pdf
// 64 páginas
//
// Um ExamApplication pode possuir vários lotes.
// Isso permite reprocessamento ou novos uploads no futuro.
// ======================================================

model AnswerSheetScanBatch {
  id String @id @default(cuid())

  examApplicationId String
  examApplication   ExamApplication @relation(fields: [examApplicationId], references: [id])

  sourceFileName String  @db.VarChar(255)
  sourceFileKey  String? @db.VarChar(500)

  totalPages          Int @default(0)
  processedPages      Int @default(0)
  identifiedPages     Int @default(0)
  reviewRequiredPages Int @default(0)
  confirmedPages      Int @default(0)

  status ScanBatchStatus @default(UPLOADED)

  scans AnswerSheetScan[]

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examApplicationId])
  @@index([status])
}

// ======================================================
// DIGITALIZAÇÃO DE UMA PÁGINA
// ======================================================
//
// Cada registro representa UMA página do arquivo multipágina.
//
// Exemplo:
// página 17 do PDF
// QR encontrado: PF-ABCD-EFGH
// AnswerSheet correspondente localizada.
//
// answerSheetId é opcional porque inicialmente a página
// ainda pode não ter sido identificada.
// ======================================================

model AnswerSheetScan {
  id String @id @default(cuid())

  scanBatchId String
  scanBatch   AnswerSheetScanBatch @relation(fields: [scanBatchId], references: [id])

  pageNumber Int

  answerSheetId String?
  answerSheet   AnswerSheet? @relation(fields: [answerSheetId], references: [id])

  detectedCode String? @db.VarChar(32)

  status AnswerSheetScanStatus @default(PENDING)

  // Confiança da identificação pelo QR.
  // Valor esperado futuramente entre 0 e 1.
  qrConfidence Float?

  // Confiança do alinhamento/correção de perspectiva.
  alignmentConfidence Float?

  // Confiança geral da leitura daquela página.
  overallConfidence Float?

  // Informações úteis para auditoria/debug do processamento.
  rotationDegrees Float?

  // Referências opcionais para imagens armazenadas fora do banco.
  // Não armazenaremos a imagem binária no MySQL.
  sourceImageKey     String? @db.VarChar(500)
  normalizedImageKey String? @db.VarChar(500)

  answers DetectedAnswer[]

  processedAt DateTime?
  reviewedAt  DateTime?
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scanBatchId, pageNumber])
  @@index([answerSheetId])
  @@index([detectedCode])
  @@index([status])
}

// ======================================================
// RESPOSTA DETECTADA PELA VISÃO COMPUTACIONAL
// ======================================================
//
// Representa o que o algoritmo detectou em UMA questão.
//
// Não representa ainda o resultado oficial.
//
// Exemplo:
//
// Questão 17
//
// A = 0.08
// B = 0.11
// C = 0.76
// D = 0.07
// E = 0.09
//
// detectedAnswer = C
// detectionStatus = DETECTED
// confidence = 0.98
//
// Depois de revisão manual, finalAnswer pode ser alterada.
// ======================================================

model DetectedAnswer {
  id String @id @default(cuid())

  answerSheetScanId String
  answerSheetScan   AnswerSheetScan @relation(fields: [answerSheetScanId], references: [id])

  question Int

  detectedAnswer Alternative?

  detectionStatus DetectedAnswerStatus

  // Confiança final da decisão do detector.
  confidence Float?

  // Percentual/intensidade de preenchimento detectado
  // em cada bolha.
  //
  // Futuramente trabalharemos normalmente entre 0 e 1.
  fillA Float?
  fillB Float?
  fillC Float?
  fillD Float?
  fillE Float?

  // Resultado final após eventual revisão humana.
  //
  // Pode permanecer null em uma questão confirmada como
  // não respondida.
  finalAnswer Alternative?

  // Permite distinguir:
  //
  // finalAnswer = null + reviewed = false
  //   → ainda não revisada
  //
  // finalAnswer = null + reviewed = true
  //   → revisão confirmou questão em branco
  reviewed Boolean @default(false)

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([answerSheetScanId, question])
  @@index([detectionStatus])
}

// ======================================================
// USUÁRIOS
// ======================================================

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(TEACHER)

  // Perfil pedagógico 1:1.
  // Apenas usuários com role = TEACHER devem possuir TeacherProfile.
  teacherProfile TeacherProfile?

  // Jornadas criadas por este usuário.
  createdJourneys Journey[] @relation("JourneyCreator")

  // Validações pedagógicas realizadas pelo usuário.
  validatedJourneySuggestions JourneySuggestion[] @relation("JourneySuggestionValidator")
  validatedJourneyBnccLinks   JourneyBnccLink[]   @relation("JourneyBnccValidator")

  // Integração com o Google Classroom.
  googleClassroomConnection GoogleClassroomConnection? @relation("GoogleClassroomConnectionUser")
  classroomPublications     ClassroomPublication[]     @relation("ClassroomPublicationCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// PERFIL PEDAGÓGICO DO PROFESSOR
// ======================================================
//
// Regra de negócio:
// - 1 usuário professor possui no máximo 1 perfil;
// - 1 professor possui exatamente 1 disciplina;
// - a área é derivada da disciplina pela aplicação e armazenada
//   para facilitar filtros, IA e cruzamento com a BNCC.
//
// Exemplo:
// HISTORIA -> CIENCIAS_HUMANAS
// BIOLOGIA -> CIENCIAS_DA_NATUREZA
// MATEMATICA -> MATEMATICA
// ======================================================

model TeacherProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cada professor possui uma única disciplina e uma única área.
  //
  // Não existe associação manual professor <-> Jornada.
  // Todos os professores participam automaticamente de todas as Jornadas.
  subject Subject
  area    KnowledgeArea

  // Uma atividade pode possuir um professor responsável.
  // Isso NÃO representa participação na Jornada.
  activities JourneyActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([area])
}

// ======================================================
// JORNADAS PEDAGÓGICAS
// ======================================================
//
// Todas as Jornadas pertencem ao ecossistema pedagógico da escola.
//
// Não existe relação N:N entre Journey e TeacherProfile.
// Todos os professores têm acesso a todas as Jornadas.
//
// A interdisciplinaridade é representada pelas sugestões,
// disciplinas, áreas e atividades da Jornada.
// ======================================================

model Journey {
  id          String        @id @default(cuid())
  title       String        @db.VarChar(180)
  description String?       @db.Text
  grade       Int
  status      JourneyStatus @default(DRAFT)

  createdById String?
  createdBy   User?   @relation("JourneyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  documents   JourneyDocument[]
  analyses    JourneyAnalysis[]
  suggestions JourneySuggestion[]
  mindMaps    JourneyMindMap[]
  activities  JourneyActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grade])
  @@index([status])
  @@index([createdById])
}

// ======================================================
// DOCUMENTOS / ROTEIROS DA JORNADA
// ======================================================
//
// Pode representar:
// - PDF;
// - DOCX;
// - texto colado;
// - outro arquivo suportado futuramente.
//
// O arquivo original fica fora do MySQL.
// O banco guarda referência e conteúdo extraído.
// ======================================================

model JourneyDocument {
  id String @id @default(cuid())

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  type JourneyDocumentType @default(FILE)

  fileName   String? @db.VarChar(255)
  mimeType   String? @db.VarChar(120)
  storageKey String? @db.VarChar(500)

  // Hash do arquivo/texto original para auditoria e deduplicação.
  sha256 String? @db.VarChar(64)

  // Texto inserido manualmente.
  sourceText String? @db.LongText

  // Texto obtido após leitura do documento.
  extractedText String? @db.LongText

  status       JourneyDocumentStatus @default(PENDING)
  errorMessage String?               @db.Text

  chunks JourneyDocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
  @@index([status])
  @@index([sha256])
}

// ======================================================
// FRAGMENTOS DOS DOCUMENTOS DA JORNADA
// ======================================================
//
// Base para RAG e evidências.
//
// O texto da Jornada é dividido em fragmentos estáveis
// e auditáveis.
// ======================================================

model JourneyDocumentChunk {
  id String @id @default(cuid())

  documentId String
  document   JourneyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  pageNumber Int?

  locator String? @db.VarChar(255)

  text     String  @db.LongText
  textHash String? @db.VarChar(64)

  // Referência opcional para índice vetorial externo.
  embeddingRef String? @db.VarChar(500)

  suggestionEvidence JourneySuggestion[]
  bnccEvidence       JourneyBnccLink[]

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([pageNumber])
  @@index([textHash])
}

// ======================================================
// EXECUÇÃO / RESULTADO DE ANÁLISE POR IA
// ======================================================
//
// Cada nova análise gera um registro próprio.
//
// Isso preserva:
// - histórico;
// - modelo;
// - versão de prompt;
// - conjunto de entradas;
// - saída;
// - possíveis erros.
// ======================================================

model JourneyAnalysis {
  id String @id @default(cuid())

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  status JourneyAnalysisStatus @default(PENDING)

  provider      String? @db.VarChar(80)
  modelName     String? @db.VarChar(120)
  promptVersion String? @db.VarChar(80)

  // Identifica exatamente o conjunto de entradas utilizado.
  inputHash String? @db.VarChar(64)

  summary String? @db.LongText

  // Saída estruturada da análise.
  output Json?

  errorMessage String? @db.Text

  suggestions JourneySuggestion[]
  bnccLinks   JourneyBnccLink[]
  mindMaps    JourneyMindMap[]

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
  @@index([status])
  @@index([inputHash])
}

// ======================================================
// MAPA MENTAL NAVEGÁVEL DA JORNADA
// ======================================================
//
// O mapa é somente leitura na primeira versão.
//
// Sua estrutura fica em JSON porque não haverá edição manual.
//
// Regra:
// - análise gera no mínimo 3 sugestões;
// - mapa representa sugestões e conteúdos possíveis;
// - nós podem apontar para suggestionId;
// - nós podem apontar para JourneyBnccLink.id.
// ======================================================

model JourneyMindMap {
  id String @id @default(cuid())

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  analysisId String?
  analysis   JourneyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  title String @db.VarChar(220)

  // Estrutura conceitual:
  //
  // Jornada
  // -> disciplina
  // -> sugestão
  // -> conteúdos
  // -> conexões
  // -> referências
  // -> BNCC
  // -> atividades
  structure Json

  schemaVersion Int @default(1)
  version       Int @default(1)

  isCurrent Boolean @default(true)

  generatedByAi Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([journeyId, version])
  @@index([journeyId])
  @@index([analysisId])
  @@index([isCurrent])
}

// ======================================================
// SUGESTÕES PEDAGÓGICAS DA IA
// ======================================================
//
// A sugestão NÃO pertence a um professor específico.
//
// Ela pertence à Jornada e é classificada por disciplina.
//
// Como todos os professores participam de todas as Jornadas,
// qualquer professor pode acessar a Jornada.
//
// Exemplos:
// - conteúdo;
// - conexão interdisciplinar;
// - referência;
// - repertório sociocultural;
// - possibilidade em sala;
// - tema de redação.
// ======================================================

model JourneySuggestion {
  id String @id @default(cuid())

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  analysisId String?
  analysis   JourneyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  subject Subject
  type    JourneySuggestionType

  title     String  @db.VarChar(220)
  objective String? @db.Text
  content   String  @db.LongText
  rationale String? @db.LongText

  contentTopics Json?

  evidenceChunkId String?
  evidenceChunk   JourneyDocumentChunk? @relation(fields: [evidenceChunkId], references: [id], onDelete: SetNull)

  evidence String? @db.Text

  status JourneyReviewStatus @default(SUGGESTED)

  validatedById String?
  validatedBy   User?   @relation("JourneySuggestionValidator", fields: [validatedById], references: [id], onDelete: SetNull)

  validatedAt DateTime?

  bnccLinks  JourneyBnccLink[]
  activities JourneyActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
  @@index([analysisId])
  @@index([subject])
  @@index([status])
  @@index([evidenceChunkId])
}

// ======================================================
// FONTE OFICIAL DA BNCC
// ======================================================
//
// A base BNCC usada pela IA deve vir exclusivamente de fontes
// oficiais previamente importadas e verificadas.
//
// Nunca salvamos um código inventado pela IA como BnccSkill.
// ======================================================

model BnccSource {
  id String @id @default(cuid())

  title     String @db.VarChar(255)
  publisher String @default("MEC") @db.VarChar(120)

  type   BnccSourceType
  status BnccSourceStatus @default(IMPORTED)

  officialUrl String  @db.VarChar(500)
  storageKey  String? @db.VarChar(500)

  versionLabel String?   @db.VarChar(120)
  publishedAt  DateTime?
  retrievedAt  DateTime  @default(now())
  verifiedAt   DateTime?

  // Fingerprint do arquivo oficial importado.
  sha256 String @unique @db.VarChar(64)

  skills BnccSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
}

// ======================================================
// BASE ESTRUTURADA DA BNCC
// ======================================================
//
// A IA NÃO cria códigos BNCC.
// Ela recebe candidatos existentes nesta tabela e avalia pertinência.
//
// O texto oficial deve ser importado de uma fonte controlada.
// ======================================================

model BnccSkill {
  id String @id @default(cuid())

  sourceId String
  source   BnccSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  code String @db.VarChar(40)

  stage BnccStage     @default(ENSINO_MEDIO)
  area  KnowledgeArea

  subject Subject?

  // Texto oficial importado da fonte verificada.
  description String @db.Text

  competencyCode String? @db.VarChar(40)
  competencyText String? @db.Text

  // Localização exata na fonte oficial para auditoria.
  sourcePage    Int?
  sourceLocator String? @db.VarChar(255)

  // Hash do texto oficial da habilidade.
  officialTextHash String? @db.VarChar(64)

  // Texto preparado para busca textual/semântica.
  searchText String? @db.LongText

  // Permite versionar a base sem apagar registros históricos.
  isCurrent Boolean @default(true)

  journeyLinks  JourneyBnccLink[]
  activityLinks JourneyActivityBnccSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, code])
  @@index([code])
  @@index([stage])
  @@index([area])
  @@index([subject])
  @@index([isCurrent])
}

// ======================================================
// VÍNCULO JORNADA <-> BNCC
// ======================================================
//
// Representa uma habilidade REAL da BNCC sugerida para a Jornada.
// A relação pode ser sugerida pela IA e depois validada pelo professor.
// ======================================================

model JourneyBnccLink {
  id String @id @default(cuid())

  // Toda associação BNCC nasce vinculada a uma sugestão concreta.
  suggestionId String
  suggestion   JourneySuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  bnccSkillId String
  bnccSkill   BnccSkill @relation(fields: [bnccSkillId], references: [id], onDelete: Restrict)

  analysisId String?
  analysis   JourneyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  // Evidência da Jornada que sustenta a associação.
  evidenceChunkId String?
  evidenceChunk   JourneyDocumentChunk? @relation(fields: [evidenceChunkId], references: [id], onDelete: SetNull)

  evidenceExcerpt String? @db.Text

  // Score da recuperação e score da avaliação da IA são separados.
  retrievalScore   Float?
  aiRelevanceScore Float?
  confidence       BnccLinkConfidence?

  candidateRank Int?

  justification String? @db.LongText

  status JourneyReviewStatus @default(SUGGESTED)

  validatedById String?
  validatedBy   User?   @relation("JourneyBnccValidator", fields: [validatedById], references: [id], onDelete: SetNull)

  validatedAt    DateTime?
  validationNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([suggestionId, bnccSkillId])
  @@index([bnccSkillId])
  @@index([analysisId])
  @@index([evidenceChunkId])
  @@index([status])
  @@index([confidence])
}

// ======================================================
// ATIVIDADES GERADAS / CONSTRUÍDAS A PARTIR DA JORNADA
// ======================================================
//
// A atividade pode ser criada pela IA, mas começa como rascunho.
// O professor valida antes de qualquer publicação externa.
//
// teacherProfileId identifica eventual RESPONSÁVEL pela atividade.
// Não representa participação do professor na Jornada.
// ======================================================

model JourneyActivity {
  id String @id @default(cuid())

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  // Sugestão pedagógica que originou a atividade.
  suggestionId String?
  suggestion   JourneySuggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)

  teacherProfileId String?
  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: SetNull)

  subject Subject

  title        String  @db.VarChar(220)
  objective    String? @db.Text
  instructions String? @db.LongText

  materials Json?

  status        JourneyActivityStatus @default(DRAFT)
  generatedByAi Boolean               @default(false)

  bnccSkills JourneyActivityBnccSkill[]

  // Publicações da atividade no Google Classroom.
  classroomPublications ClassroomPublication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
  @@index([suggestionId])
  @@index([teacherProfileId])
  @@index([subject])
  @@index([status])
}

// ======================================================
// ATIVIDADE <-> HABILIDADES BNCC
// ======================================================

model JourneyActivityBnccSkill {
  journeyActivityId String
  journeyActivity   JourneyActivity @relation(fields: [journeyActivityId], references: [id], onDelete: Cascade)

  bnccSkillId String
  bnccSkill   BnccSkill @relation(fields: [bnccSkillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([journeyActivityId, bnccSkillId])
  @@index([bnccSkillId])
}

// ======================================================
// GOOGLE CLASSROOM
// ======================================================
//
// Uma conexão OAuth pertence a um usuário.
//
// ClassroomPublication mantém o vínculo entre a atividade
// interna do Performance e o CourseWork criado no Classroom.
//
// Nesta fase, a existência do model NÃO significa que uma
// atividade já foi publicada. O registro poderá começar como
// PENDING e receber os IDs do Google posteriormente.
// ======================================================

model GoogleClassroomConnection {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("GoogleClassroomConnectionUser", fields: [userId], references: [id], onDelete: Cascade)

  // Refresh token armazenado criptografado.
  refreshTokenEncrypted String @db.Text

  // Scopes efetivamente concedidos pelo Google.
  grantedScopes String? @db.Text

  status ClassroomConnectionStatus @default(CONNECTED)

  connectedAt DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ClassroomPublication {
  id String @id @default(cuid())

  journeyActivityId String
  journeyActivity   JourneyActivity @relation(fields: [journeyActivityId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ClassroomPublicationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // Turma do Google Classroom escolhida pelo professor.
  googleCourseId   String  @db.VarChar(255)
  googleCourseName String? @db.VarChar(500)

  // Preenchidos após a criação do CourseWork.
  googleCourseWorkId    String? @db.VarChar(255)
  googleCourseWorkState String? @db.VarChar(50)

  status ClassroomPublicationStatus @default(PENDING)

  errorMessage String? @db.Text

  classroomCreatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Impede publicar a mesma atividade duas vezes
  // na mesma turma através do fluxo normal da aplicação.
  @@unique([journeyActivityId, googleCourseId])
  @@index([journeyActivityId])
  @@index([createdById])
  @@index([googleCourseId])
  @@index([googleCourseWorkId])
  @@index([status])
}

// ======================================================
// REDAÇÃO
// ======================================================

model EssayCorrection {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id])

  competency1 Int @default(0)
  competency2 Int @default(0)
  competency3 Int @default(0)
  competency4 Int @default(0)
  competency5 Int @default(0)

  totalScore Int @default(0)

  comment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examId])
}

// ======================================================
// LEITURAS
// ======================================================

model Book {
  id String @id @default(cuid())

  title       String
  author      String
  description String?        @db.Text
  category    BookCategory
  type        BookType
  difficulty  BookDifficulty @default(MEDIUM)

  literarySchool String?
  originalYear   Int?
  publicDomain   Boolean @default(true)
  sourceUrl      String?

  vestibularRelevance String?
  enemRelevance       String? @db.Text
  themes              String? @db.Text
  readingTimeMinutes  Int?

  progresses BookProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, author])
}

model BookProgress {
  id String @id @default(cuid())

  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  status   ReadingStatus @default(WANT_TO_READ)
  progress Int           @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, studentId])
}

// ======================================================
// MODELOS LEGADOS
// ======================================================

model LegacyAluno {
  id      Int     @id @default(autoincrement())
  nome    String  @db.VarChar(100)
  tecnico String  @db.VarChar(100)
  serie   String? @db.Char(14)

  redacoes   LegacyRedacao[]
  resultados LegacyResultado[]

  @@map("alunos")
}

model LegacySimulado {
  id          Int    @id @default(autoincrement())
  jornada     String @db.VarChar(100)
  numeroProva Int    @map("numero_prova")
  serie       String @db.VarChar(45)

  redacoes   LegacyRedacao[]
  resultados LegacyResultado[]

  @@unique([jornada, numeroProva, serie], map: "unique_simulado")
  @@map("simulados")
}

model LegacyRedacao {
  id         Int  @id @default(autoincrement())
  alunoId    Int  @map("aluno_id")
  simuladoId Int? @map("simulado_id")

  competencia1 Int? @default(0)
  competencia2 Int? @default(0)
  competencia3 Int? @default(0)
  competencia4 Int? @default(0)
  competencia5 Int? @default(0)

  notaTotal  Int?      @default(0) @map("nota_total")
  comentario String?   @db.Text
  dataEnvio  DateTime? @default(now()) @map("data_envio")

  aluno    LegacyAluno     @relation(fields: [alunoId], references: [id])
  simulado LegacySimulado? @relation(fields: [simuladoId], references: [id])

  @@index([alunoId], map: "redacoes_aluno_id_idx")
  @@index([simuladoId], map: "redacoes_simulado_id_idx")
  @@map("redacoes")
}

model LegacyResultado {
  id         Int  @id @default(autoincrement())
  alunoId    Int? @map("aluno_id")
  simuladoId Int? @map("simulado_id")

  matematica     Int? @default(0)
  portugues      Int? @default(0)
  biologia       Int? @default(0)
  fisica         Int? @default(0)
  quimica        Int? @default(0)
  ingles         Int? @default(0)
  sociologia     Int? @default(0)
  filosofia      Int? @default(0)
  historia       Int? @default(0)
  geografia      Int? @default(0)
  educacaoFisica Int? @default(0) @map("educacao_fisica")
  artes          Int? @default(0)

  totalAcertos  Int? @default(0) @map("total_acertos")
  totalErros    Int? @default(0) @map("total_erros")
  totalQuestoes Int? @default(0) @map("total_questoes")

  aluno    LegacyAluno?    @relation(fields: [alunoId], references: [id])
  simulado LegacySimulado? @relation(fields: [simuladoId], references: [id])

  @@unique([alunoId, simuladoId], map: "unique_aluno_simulado")
  @@index([alunoId], map: "resultados_aluno_id_idx")
  @@index([simuladoId], map: "resultados_simulado_id_idx")
  @@map("resultados")
}

